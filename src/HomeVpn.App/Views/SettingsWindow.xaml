<Window x:Class="HomeVpn.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home VPN – Einstellungen"
        Width="820" Height="650" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Einstellungen" FontSize="23" FontWeight="Bold"/>
            <TextBlock Text="Excluded Networks pausieren ausschließlich den automatischen VPN-Aufbau. Ein erlaubter manueller Override gilt nur bis zum nächsten Netzwerkwechsel bzw. App-Neustart."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="15" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="AutostartCheck" Content="Beim Windows-Login starten und gespeicherte Profilzustände anwenden" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Standard-VPN" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="PrimaryProfileBox" Margin="0,5,0,0" Height="30" DisplayMemberPath="DisplayName"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="15" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Ausgeschlossene Netzwerke" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Sind Name und Subnetz gesetzt, müssen beide Merkmale passen. * und ? sind im Netzwerknamen als Wildcards erlaubt."
                                   Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Aktuelles hinzufügen" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0" Click="AddCurrent_Click"/>
                        <Button Content="Neu" Style="{StaticResource SecondaryButton}" Click="AddBlank_Click"/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="RulesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                          RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                        <DataGridTextColumn Header="Netzwerkname / SSID" Binding="{Binding NetworkNamePattern, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                        <DataGridTextColumn Header="Subnetz (CIDR)" Binding="{Binding SubnetCidr, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                        <DataGridCheckBoxColumn Header="Override" Binding="{Binding AllowManualOverride, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Ausgewählte Regel entfernen" Style="{StaticResource SecondaryButton}" Click="RemoveSelected_Click"/>
                    <TextBlock x:Name="ValidationText" Foreground="{StaticResource RedBrush}" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Speichern" Style="{StaticResource PrimaryButton}" Padding="20,10" FontSize="13" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
