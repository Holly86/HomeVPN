<Window x:Class="HomeVpn.Views.SplitDnsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Heimnetz-DNS · HomeVPN" Width="590" Height="520" MinWidth="500" MinHeight="440" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Heimnetz-Namen im Split-Tunnel" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <TextBlock x:Name="ProfileText" Grid.Row="1" Margin="0,6,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
  <TextBlock Grid.Row="2" Text="Optionaler Heim-DNS-Server (IP-Adresse; leer = deaktiviert)" TextWrapping="Wrap"/>
  <TextBox x:Name="ServerBox" Grid.Row="3" MaxLength="45" Margin="0,6,0,12" AutomationProperties.Name="Heim-DNS-Server"/>
  <TextBlock Grid.Row="4" Text="Heimnetz-Domänen, eine pro Zeile (z. B. fritz.box oder home.arpa)" TextWrapping="Wrap" Margin="0,0,0,6"/>
  <TextBox x:Name="DomainsBox" Grid.Row="5" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="4096" MinHeight="48" AutomationProperties.Name="Heimnetz-Domänen"/>
  <StackPanel Grid.Row="6" Margin="0,12,0,10"><TextBlock Text="Bei aktivem Split-Tunnel gehen diese Domänen und ihre Unterdomänen direkt an den Heim-DNS. Andere Namen verwenden weiterhin den lokalen DNS. Verwenden Sie vollständige Namen wie nas.home.arpa." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ApplyHint" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock x:Name="ValidationText" Foreground="{StaticResource RedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Abbrechen" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button x:Name="SaveButton" Content="Übernehmen" Click="Save_Click" Style="{StaticResource PrimaryButton}" Padding="20,10" FontSize="13"/></StackPanel>
 </Grid>
</Window>
