<Window x:Class="HomeVpn.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="HomeVPN" Width="780" Height="660" MinWidth="620" MinHeight="460" WindowStartupLocation="CenterScreen">
 <Grid x:Name="LayoutRoot" Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="BrandHeader" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="HomeVPN" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="NetworkValue" Grid.Column="1" Text="Netzwerk wird erkannt …" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="360"/>
  </Grid>
  <Border x:Name="ProfileCard" Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid Width="48" Height="56"><Viewbox><Path Fill="{StaticResource GreenBrush}" Data="M32,3 L57,13 55,35 Q52,51 32,61 Q12,51 9,35 L7,13 Z M17,29 L21,33 24,30 24,46 30,46 30,36 36,36 36,46 42,46 42,30 45,33 49,29 33,15 Z"/></Viewbox>
     <Border x:Name="StatusBadge" Width="22" Height="22" CornerRadius="11" Background="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock x:Name="StatusBadgeText" Text="–" Foreground="White" HorizontalAlignment="Center"/></Border>
    </Grid>
    <StackPanel Grid.Column="1" Margin="8,0,14,0"><TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Width="190"><ComboBox x:Name="ProfileSelector" DisplayMemberPath="DisplayName" SelectionChanged="ProfileSelector_SelectionChanged"/><Border x:Name="PrimaryProfileChip" Visibility="Collapsed" Margin="0,6,0,0"><TextBlock Text="Standard-VPN" Foreground="{StaticResource GreenBrush}" FontSize="11"/></Border></StackPanel>
   </Grid>
  </Border>
  <Border x:Name="PolicyBanner" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource OrangeSoftBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PolicyBannerTitle" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="PolicyBannerText" FontSize="12" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel><Button x:Name="OverrideButton" Grid.Column="1" Content="Trotzdem verbinden" Style="{StaticResource SecondaryButton}" Click="OverrideButton_Click" VerticalAlignment="Center"/></Grid>
  </Border>
  <Border x:Name="ErrorBanner" Grid.Row="3" Visibility="Collapsed" Background="#FFF0F2" CornerRadius="8" Padding="10" Margin="0,0,0,8"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource RedBrush}" FontSize="12"/></Border>
  <Grid Grid.Row="4" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Verbindung" FontSize="11" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ConnectionValue" FontWeight="SemiBold"/><TextBlock x:Name="TunnelValue" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="RoutingValue"/><TextBlock x:Name="DurationValue" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/></StackPanel>
  </Grid>
  <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,10,0"><TextBlock Text="Verkehr über VPN" FontSize="12" Margin="0,0,0,5"/><UniformGrid Columns="2"><RadioButton x:Name="HomeOnlyRadio" GroupName="Routing" Content="Nur Heimnetz" Style="{StaticResource SegmentRadio}" Padding="8,9" Checked="RoutingRadio_Checked"/><RadioButton x:Name="FullTunnelRadio" GroupName="Routing" Content="Gesamter Verkehr" Style="{StaticResource SegmentRadio}" Padding="8,9" Checked="RoutingRadio_Checked"/></UniformGrid></StackPanel>
   <Button x:Name="PrimaryButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="10,12" VerticalAlignment="Bottom" Click="PrimaryButton_Click"><TextBlock x:Name="PrimaryButtonText" TextWrapping="Wrap" FontSize="14" TextAlignment="Center"/></Button>
  </Grid>
  <Grid Grid.Row="6" Margin="0,12,0,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Weitere Verbindungen" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
   <ListBox x:Name="OtherProfiles" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
    <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Profile.DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="Öffnen" Tag="{Binding Profile.Id}" Click="OtherSelect_Click" Style="{StaticResource SecondaryButton}" Margin="8,0"/><Button Grid.Column="2" Content="{Binding Action}" Tag="{Binding Profile.Id}" Click="OtherToggle_Click" Style="{StaticResource SecondaryButton}"/></Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </Grid>
  <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterText" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/><Button x:Name="ImportButton" Grid.Column="1" Content="Verbindung hinzufügen" Style="{StaticResource SecondaryButton}" Click="ImportButton_Click" Margin="0,0,8,0"/><Button Grid.Column="2" Content="Einstellungen" Style="{StaticResource SecondaryButton}" Click="SettingsButton_Click"/></Grid>
 </Grid>
</Window>
