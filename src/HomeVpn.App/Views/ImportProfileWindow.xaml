<Window x:Class="HomeVpn.Views.ImportProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WireGuard-Konfiguration importieren"
        Width="650" Height="650" MinWidth="600" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="WireGuard-Profil einrichten" FontSize="23" FontWeight="Bold"/>
                <TextBlock x:Name="SourceText" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Profilname" FontWeight="SemiBold"/>
                    <TextBox x:Name="DisplayNameBox" Margin="0,7,0,15" Padding="10,8" FontSize="13"/>
                    <TextBlock Text="WireGuard-Tunnelname" FontWeight="SemiBold"/>
                    <TextBox x:Name="TunnelNameBox" Margin="0,7,0,6" Padding="10,8" FontSize="13"/>
                    <TextBlock Text="Aus diesem Namen werden zwei lokale Dienste erzeugt: &lt;Name&gt; und &lt;Name&gt;-Full. Beide verwenden dieselben Schlüssel und denselben FRITZ!Box-Peer."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Heimnetz über VPN (Split Tunnel)" FontWeight="SemiBold"/>
                    <TextBlock Text="CIDR-Netze, die im Modus „Nur Heimnetz“ über WireGuard geroutet werden. Bei einer typischen FRITZ!Box ist das z. B. 192.168.178.0/24. Erkannte Werte sind nur Vorschläge und sollten geprüft werden."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,9"/>
                    <TextBox x:Name="HomeCidrsBox" AcceptsReturn="True" MinHeight="82" Padding="10,8" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="CurrentNetworkText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#EEF6FF" BorderBrush="#C8DFF5" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,0,14">
                <TextBlock Text="Full Tunnel setzt AllowedIPs lokal auf 0.0.0.0/0 (und bei erkannter IPv6-Konfiguration zusätzlich ::/0). WireGuard for Windows aktiviert bei /0-Routen seine Full-Tunnel-/Kill-Switch-Semantik."
                           Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="4" Margin="2,4,0,10">
                <CheckBox x:Name="HomeExclusionCheck" Content="Aktuelles Netzwerk für genau dieses Profil als „Zuhause“ automatisch ausschließen, wenn es zu einem Heimnetz-CIDR passt" FontSize="12"/>
                <CheckBox x:Name="MakePrimaryCheck" Content="Dieses Profil als Standard-VPN verwenden" Margin="0,10,0,0" FontSize="12"/>
            </StackPanel>
            <CheckBox x:Name="AutostartCheck" Grid.Row="5" Content="Home VPN beim Windows-Login starten und die gespeicherten Profilzustände wiederherstellen"
                      IsChecked="True" Margin="2,0,0,18" FontSize="12"/>

            <TextBlock x:Name="ValidationText" Grid.Row="6" Foreground="{StaticResource RedBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Importieren und installieren" Style="{StaticResource PrimaryButton}" Padding="20,10" FontSize="13" Click="Import_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
